# Environment Configuration Example
# Copy to .env and populate credentials if using remote database/services

# Optional Supabase Database Credentials (Bonus Module)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Scraper Settings
LOG_LEVEL=INFO
HEADLESS=true
MIN_DISNEY_PAGES=35
